---
const { post: { title, description, content, created_at, image } } = Astro.props
---

<article class="rounded-lg bg-gray-800 text-white p-4 mb-4">
  <img class="rounded w-full aspect-video object-cover" src={image} alt={title}>
  <h2 class="text-lg font-bold mt-4">{title}</h2>
  <p class="text-gray-300 mt-2">{description}</p>
  <p class="text-gray-300 mt-2">{content.slice(0, 80)}...</p>
  <p class="text-sm text-gray-400 mt-4">
    {new Date(created_at).toLocaleDateString()}
  </p>
</article>
